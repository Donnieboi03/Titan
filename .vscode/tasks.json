{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-std=c++20",
                "-stdlib=libc++",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/core",
                "-I/opt/homebrew/include",
                "${file}",                                   // The file you are currently looking at
                "-L/opt/homebrew/lib",
                "-lhwy",
                "-lz",
                "-pthread",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"  // Output goes in the same folder as the source
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "General Titan Build: Compiles active file + market_data_stream"
        }
    ]
}